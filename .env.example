# =============================================================================
# Pasok v1 — Environment Variables (Server-Side Only)
# Copy to .env.local and fill in values from your Supabase project.
# Notice: None of these variables use NEXT_PUBLIC_ so neither the Supabase URL
# nor any key is exposed to browser bundles. All DB and auth flows run on the
# server via lib/data and lib/auth.
# =============================================================================

# Supabase project URL (server-side only)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable / anon key (used only by server-side SSR auth flows in lib/auth)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service_role secret key (used ONLY inside lib/data on the server)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Default demo class UUID for v1 single-class routing
PASOK_DEFAULT_CLASS_ID=11111111-1111-4111-8111-111111111111
